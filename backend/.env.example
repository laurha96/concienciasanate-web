# Backend (Railway/Node)
PORT=5000
CORS_ORIGIN=http://localhost:3000

SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Mínimo 32 caracteres (usuarios finales)
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

# Recomendado en producción: secreto distinto para el panel admin
# Si no se define, se usa JWT_SECRET (compatibilidad local)
ADMIN_JWT_SECRET=CHANGE_ME_TO_ANOTHER_LONG_RANDOM_SECRET
